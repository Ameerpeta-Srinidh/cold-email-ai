# ── Required (Email Sending) ──────────────────────────────
# We recommend creating a new, dedicated Gmail account (e.g., yourname.internships@gmail.com)
# Create an App Password for this account to use as SMTP_PASS.
SMTP_USER=
SMTP_PASS=
FROM_NAME=

# ── Required (AI Generation) ──────────────────────────────
# Ensure your local Ollama is running and has the model pulled.
OLLAMA_MODEL=llama3
OLLAMA_URL=http://localhost:11434/api/chat

# ── Discovery ─────────────────────────────────────────────
SERPAPI_KEY=
HUNTER_API_KEY=

# ── Profile ───────────────────────────────────────────────
LINKEDIN_URL=
PORTFOLIO_URL=
RESUME_PATH=

# ── Optional ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
DAILY_LIMIT=30
DATABASE_PATH=
